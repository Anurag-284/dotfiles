# Resizing Windows
bindsym $mod+r mode "resize"

mode "resize" {
    #Resize with vim keys
    bindsym j resize shrink width 5 px or 5 ppt
    bindsym k resize grow height 5 px or 5 ppt
    bindsym l resize shrink height 5 px or 5 ppt
    bindsym semicolon resize grow width 5 px or 5 ppt

    #Resize with arrow keys
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt

    #Exit resize mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

#---------------------------------------------------------------------------------------------------------------
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec ~/.config/i3/powermenu.sh
bindsym $mod+l exec betterlockscreen -l
bindsym Print exec --no-startup-id maim ~/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png
bindsym $mod+Print exec --no-startup-id maim -s ~/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png
bindsym $sup+p exec --no-startup-id /opt/rofi-fan-control.sh
bindsym $sup+r exec --no-startup-id pkill -USR1 redshift

# Autostart Section----------------------------------------------------------------------------------------------
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id clipmenud
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf

exec_always --no-startup-id dunst -conf ~/.config/dunst/dunstrc-with-colors &
exec --no-startup-id eww daemon &
exec --no-startup-id mpd &

# Launch Eww bar
#exec_always --no-startup-id ~/.config/eww/launch.sh

# Start all music services in the correct order
exec --no-startup-id ~/.config/polybar/Scripts/start_music_services.sh

# Use 'wal' to set the wallpaper and theme on startup.
exec_always --no-startup-id wal -R -o ~/.config/wal/polybar-refresh.sh && ~/.config/polybar/launch.sh &
## mouse follow focus.
focus_follows_mouse no

for_window [class="eww-dashboard_window"] floating enable, move position center
