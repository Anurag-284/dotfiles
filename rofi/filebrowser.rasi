/*
 * Rofi theme for a Wallpaper File Browser (Corrected)
 * This file is generated by a script to ensure correctness.
 */

/* First, import the pywal colors. This MUST be at the top level. */
@import "~/.cache/wal/colors-rofi-vars.rasi"

* {
    background-color:   @background;
    text-color:         @foreground;
    font:               "JetBrainsMono Nerd Font 10";
}

window {
    width:            60%;
    height:           80%;
    padding:          32px;
    border:           2px;
    border-radius:    12px;
    border-color:     @color8;
}

mainbox {
    children:   [ "inputbar", "listview" ];
    spacing:    20px;
}

inputbar {
    padding:    8px;
    border-radius: 8px;
    border: 1px solid @color8;
}

listview {
    columns:    4;
    lines:      3;
    spacing:    20px;
    cycle:      true;
    layout:     vertical;
}

element {
    padding:        10px;
    border-radius:  8px;
    orientation:    vertical;
}

element-icon {
    size:           128px;
    cursor:         pointer;
}

element-text {
    horizontal-align: 0.5;
}

element selected {
    background-color: @color1;
    text-color:       @background;
}
