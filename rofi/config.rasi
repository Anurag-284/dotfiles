/*
 * This file now only sets basic behavior and imports
 * the complete theme generated by pywal.
 */

configuration {
    modi:           "drun,run";
    show-icons:     true;
    font:           "JetBrainsMono Nerd Font 12";
    kb-cancel:      "Escape";
}

@import "~/.cache/wal/colors-rofi-dark.rasi"
