/*
 * Rofi theme for a modern, centered look
 * Based on the Catppuccin Mocha theme, but adapted for Pywal
 */

* {
    /* Colors are imported from pywal in config.rasi */
    background-color: @background;
    text-color:       @foreground;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    width:            30%;
    height:           50%;
    padding:          20px;
    border:           2px;
    border-radius:    12px;
    border-color:     @color8; /* A slightly brighter color for the border */
    background-color: @background;
}

mainbox {
    children:         [ "inputbar", "listview" ];
    spacing:          20px;
    padding:          10px;
}

inputbar {
    children:         [ "prompt", "entry" ];
    spacing:          10px;
    padding:          10px;
    border:           0px 0px 2px 0px;
    border-color:     @color8;
    background-color: @background;
}

prompt {
    enabled:          true;
    text-color:       @color4; /* A prominent color for the prompt */
}

entry {
    placeholder:      "Search...";
    placeholder-color: @color7; /* A subtle color for the placeholder */
    background-color: inherit;
}

listview {
    columns:          1;
    lines:            8;
    spacing:          10px;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
}

element {
    orientation:      horizontal;
    padding:          8px;
    border-radius:    8px;
}

element-icon {
    size:             1.5em;
    padding:          0px 10px 0px 0px;
}

element-text {
    vertical-align:   0.5;
}

/* Style for selected element */
element selected {
    background-color: @color1; /* A highlight color */
    text-color:       @background;
}
